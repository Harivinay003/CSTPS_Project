    function loadTrendModal() {

    $.ajax({
    url: '/Analytics',

    type: 'GET',

    data: {

    handler: 'Trend',
    fieldDeviceId: selectedFieldDeviceId,
    graphType: selectedGraph,
    from: $('#trendFrom').val(),
