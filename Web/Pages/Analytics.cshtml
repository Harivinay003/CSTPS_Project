 <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script> 
<script>
    var colorPalette = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b', '#e377c2', '#7f7f7f', '#bcbd22', '#17becf'];
    let selectedGraph = "current";
    let selectedFieldDeviceId = 0;
    var trendLayout = null;
    (function () {
    // Ensure Plotly is available, otherwise load from CDN, then render
    function ensurePlotly() {
    return new Promise(function (resolve, reject) {
    if (window.Plotly) return resolve(window.Plotly);
    var script = document.createElement('script');
    // Load local Plotly bundle from wwwroot (offline use)
    script.src = '@Url.Content("~/lib/plotly.js/plotly-basic.min.js")';
    script.onload = function () { return resolve(window.Plotly); };
    script.onerror = function (e) { return reject(new Error('Failed to load Plotly')); };
    document.head.appendChild(script);
    });
    }
      function ensureMinJS() {
                return new Promise(function (resolve, reject) {
                    if (window.jQuery) {
                        return resolve(window.jQuery);
                    }
                    var script = document.createElement('script');
                    script.src = '@Url.Content("~/lib/jquery-3.7.1.min.js")';
                    script.onload = function () {
                        resolve(window.jQuery);
                    };
                    script.onerror = function () {
                        reject(new Error("Failed to load jQuery."));
                    };
                    document.head.appendChild(script);
                });
            }
    
         Promise.all([
                ensureMinJS(),
                ensurePlotly()
            ])
    .then(function () {
        var trendTrace = {
            x : [],
            y: [],
            type: 'scatter',
            mode: 'lines+markers',
            name: 'Current (A)',
            line: {
                color: '#3498db',
                width: 4,
                shape: 'spline',
                smoothing: 1.2
            },
            marker: {
                color: '#3498db',
                size: 7
            },
            fill: false,
            fillcolor: 'rgba(52,152,219,0.15)',
            hovertemplate: '<b>%{x}</b><br>' + 'Current: %{y} A<extra></extra>'
        };
        trendLayout = {
            autosize: true,
            height: 340,
            margin: {
                t: 10,
                l: 55,
                r: 20,
                b: 60
            },
            paper_bgcolor: 'transparent',
            plot_bgcolor: 'transparent',
            hovermode: 'x unified',
            showlegend: true,
            legend: {
                orientation: 'h',
                y: 1.12,
                x: 0.35
            },
            xaxis: {
                showgrid: false,
                tickangle: 0,
                tickfont: {
                    size: 11
                }
            },
            yaxis: {
                title: {
                    text: 'Current (A)'
                },                 
                range: [0, 300],
                tick0: 0,
                gridcolor: 'rgba(0,0,0,0.06)',
                zeroline: false,
                tickfont: {
                    size: 11
                }
            }
        };
        var config = {
            responsive: true,
            displayModeBar: true,
            modeBarButtonsToRemove: [
                'lasso2d',
                'select2d'
            ],
            displaylogo: false
        };

        Plotly.newPlot(
            'currentChart',
            [trendTrace],
            trendLayout,
            config
        );
    })
    .catch(function (err) {
        console.error(err);
    });
    })();  

    function updateTrendChart(trendTime, trendSeries, graphType) {

        let traces = [];

        trendSeries.forEach(function(series, index) {

            traces.push({

                x: trendTime,

                y: series.values,

                name: series.name,

                type: 'scatter',

                mode: 'lines',

                line: {
                    width: 3,
                    color: colorPalette[index % colorPalette.length]
                },

                hovertemplate:
                    '%{y:.2f}<extra>' +
                    series.name +
                    '</extra>'

            });

        });

        Plotly.react(

            'currentChart',

            traces,

            {

                ...trendLayout,

                showlegend: true,

                legend: {
                    orientation: 'h',
                    y: 1.12,
                    x: 0.3
                },

                xaxis: {
                    showgrid: false,
                    tickmode: 'auto',
                    nticks: 24
                },

                yaxis: {
                    title: {
                        text:
                            graphType === "current"
                                ? "Current (A)"
                                : graphType === "voltage"
                                    ? "Voltage (V)"
                                    : "Power (kW)"
                    }
                }

            }

        );

    }
    function updateLastSync() {
    const now = new Date();

    const options = {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: true
    };

    $('#lastSync').text(now.toLocaleString('en-GB', options));
    }
    function loadDashboard(fieldDeviceId)
    {
    selectedFieldDeviceId = fieldDeviceId;
        $.get(
            '/Analytics?handler=FieldDeviceDashboard',
            {
                fieldDeviceId: fieldDeviceId,
                graphType: selectedGraph,
                selectedDate: $('#selectedDate').val()
            })
        .done(function(data){

            $('#runHoursValue').text(data.runHours + ' Hrs');
             updateRunProgress(data.runHours);
            $('#currentRunHoursValue').text(data.currentRunHours + ' Hrs');
            $('#energyValue').text(data.energyConsumption + ' kWh');
            $('#alarmValue').text(data.alarmCount);
            $('#tripValue').text(data.tripCount);
           
                // Alarm animation
                if (data.alarmCount > 0) {
                    $('#alarmIcon').addClass('active-alarm');
                    $('#alarmDot').show();
                } 
                else {
                    $('#alarmIcon').removeClass('active-alarm');
                    $('#alarmDot').hide();
                }
                // Trip animation
                if (data.tripCount > 0) {
                    $('#tripIcon').addClass('active-trip');
                    $('#tripDot').show();
                } 
                else {
                    $('#tripIcon').removeClass('active-trip');
                    $('#tripDot').hide();
                }
    updateLastSync();
    $('#selectedDeviceName').text($('.fielddevice[data-id="' + selectedFieldDeviceId + '"]').text().trim());

    if(data.isRunning){

                    $('#deviceStatus')
                        .text("RUNNING " + data.direction.toUpperCase())
                        .removeClass("device-stopped")
                        .addClass("device-running");

    $('#deviceDot')
    .removeClass("stopped")
    .addClass("running");

    }
    else{

    $('#deviceStatus')
    .text("STOPPED")
    .removeClass("device-running")
    .addClass("device-stopped");

    $('#deviceDot')
    .removeClass("running")
    .addClass("stopped");

    }

       updateTrendChart(data.trendTime, data.trendSeries,selectedGraph);

    $('#graphTitle').text(data.graphTitle);
 
        })
        .fail(function(xhr){
            console.log("AJAX ERROR");
            console.log(xhr);
        });
    }
    function updateRunProgress(runHours) {
    let percent = (parseFloat(runHours) / 24) * 100;
    percent = Math.min(percent, 100);
    $('#runProgress').css('background',`conic-gradient(#1db954 ${percent * 3.6}deg, #e9edf3 0deg)` );
    }
    //Run Hours
    function loadRunHours() {
    $('#runLogBody').html(`
    <tr>
    <td colspan="4" class="text-center">
    Loading...
    </td>
    </tr>
    `);

    $('#runTimeline').html("");

    $.ajax({

    url: '/Analytics',

    type: 'GET',

    data: {

    handler: 'RunHours',

    fieldDeviceId: selectedFieldDeviceId,

    selectedDate: $('#runDate').val()

    },

    success: function (data) {

    $('#todayRunHours').text(data.todayRunHours + ' Hrs');
    $('#totalRunHours').text(data.totalRunHours);
    $('#startCount').text(data.startCount);

    // Timeline
    $('#runTimeline').html(data.timelineHtml);
    updateRunProgress(data.todayRunHours);
    // Runtime Log
    let tbody = $('#runLogBody');

    tbody.empty();

    if (!data.logs || data.logs.length === 0) {

    tbody.append(`
    <tr>
    <td colspan="4" class="text-center">
    No runtime found
    </td>
    </tr>
    `);
    return;
    }
    data.logs.forEach(function (log) {
    tbody.append(`
    <tr>
    <td>${formatDate(log.onTime)}</td>
    <td>${log.offTime ? formatDate(log.offTime) : '-'}</td>
    <td>${log.runtime.toFixed(2)} Hrs</td>
    <td>
    <span class="${log.isRunning ? 'badge-running' : 'badge-stop'}">
        ${log.isRunning ? `Running ${log.direction}` : `Stopped ${log.direction}`}
    </span>
    </td>
    </tr>
    `);
    });
    }
    });
    }

    // energyConsumption js
    function loadEnergyChart(type) {
    $.ajax({
    url: '/Analytics',
    type: 'GET',
    data: {
    handler: 'EnergyData',
    duration: type,
    fieldDeviceId: selectedFieldDeviceId,
    selectedDate: $('#energyDate').val()
    },
              success: function(data) {

                const colorPalette = [
                    "#3B82F6",
                    "#10B981",
                    "#F59E0B",
                    "#EF4444",
                    "#8B5CF6",
                    "#06B6D4",
                    "#EC4899",
                    "#84CC16"
                ];

                let traces = [];

                data.series.forEach(function(series, index) {
                let displayName = series.name
                    .replace("Conv_", "")
                    .replace("_Energy_", " ")
                    .replace("_Drv_", " Drive ");

                    traces.push({

                        x: data.xData,

                        y: series.values,

                        // name: series.name,
                        name: displayName,
                        type: 'bar',
                        marker: {
                            color: colorPalette[index % colorPalette.length]
                        },
                        text: series.values,  
                        textposition: "none",
                        hovertemplate:
                            '<b>%{fullData.name}</b><br>' +
                            'Time: %{x}<br>' +
                            'Energy: %{y:.2f} kWh' +
                            '<extra></extra>'
                    });

                });

                var layout = {
                    title: {
                        text: type.toUpperCase() + ' Energy Consumption',
                        x: 0.5,
                        xanchor: 'center',
                        y: 0.98,
                        font: {
                            size: 26
                        }
                    },

                    barmode: 'group',

                    xaxis: {
                        title: 'Time',
                        type: 'category'
                    },

                    yaxis: {
                        title: 'Energy (kWh)'
                    },

                    legend: {
                        orientation: "h",
                        x: 0.5,
                        xanchor: "center",
                        y: 1.05
                    },

                    margin: {
                        t: 120
                    }
                };

                Plotly.react(
                    'energyChart',
                    traces,
                    layout,
                    {
                        responsive: true,
                        displaylogo: false
                    }
                );
            }
    });
    }
    function openEnergyModal() {
    $('#energyDate').val($('#selectedDate').val());
    $('#energyDuration').val('day');
    $('#energyDeviceName').text($('#selectedDeviceName').text());
    $('#energyModal').modal('show');
    $('#energyModal').one('shown.bs.modal', function () {
    loadEnergyChart($('#energyDuration').val());
    });
    }

    // alarms JS
    function openAlarmModal() {
    $('#alarmDate').val($('#selectedDate').val());
    $('#alarmDuration').val('day');
    $('#alarmDeviceName').text($('#selectedDeviceName').text());
    $('#alarmModal').modal('show');
    $('#alarmModal').one('shown.bs.modal', function () {
    loadAlarms();
    });
    }

    function loadAlarms() {
    $('#alarmTableBody').html('<tr><td colspan="5" class="text-center">Loading...</td></tr>');
    $.ajax({
    url: '/Analytics',
    type: 'GET',
    data: {
    handler: 'AlarmDetails',
    duration: $('#alarmDuration').val(),
    fieldDeviceId: selectedFieldDeviceId,
    selectedDate: $('#alarmDate').val()
    },
    success: function (data) {

    let tbody = $('#alarmTableBody');

    tbody.empty();

    if (!data || data.length === 0) {
    tbody.append(`
    <tr>
    <td colspan="5" class="text-center">
    No alarms found
    </td>
    </tr>
    `);
    return;
    }

    data.forEach(function (alarm) {
    let statusBadge = alarm.status === "Active"? '<span class="badge bg-danger">Active</span>': '<span class="badge bg-success">Cleared</span>';
    tbody.append(`
    <tr>
    <td>${alarm.tagName}</td>
    <td>${alarm.alarmDescription}</td>
    <td>${formatDate(alarm.alarmOnTime)}</td>
    <td>${alarm.alarmOffTime ? formatDate(alarm.alarmOffTime) : '-'}</td>
    <td>${statusBadge}</td>
    </tr>
    `);
    });
    },
    error: function (xhr, status, error) {
    console.log("Alarm API Error:", error);
    console.log(xhr.responseText);
    }
    });
    }
    function formatDate(dateString) {

    let d = new Date(dateString);

    return d.toLocaleString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
    });
    }

    //Trips Js
    function openTripModal() {
    $('#tripDate').val($('#selectedDate').val());
    $('#tripDuration').val('day');
    $('#tripDeviceName').text($('#selectedDeviceName').text());
    $('#tripModal').modal('show');
    $('#tripModal').one('shown.bs.modal', function () {
    loadTrips();
    });
    }

    function loadTrips() {
    $.ajax({
    url: '/Analytics',
    type: 'GET',
    data: {
    handler: 'TripDetails',
    duration: $('#tripDuration').val(),
    fieldDeviceId: selectedFieldDeviceId,
    selectedDate: $('#tripDate').val()
    },
    success: function (data) {

    let tbody = $('#tripTableBody');

    tbody.empty();

    if (!Array.isArray(data) || data.length === 0)
    {
    tbody.append(`
    <tr>
    <td colspan="5" class="text-center">
    No trips found
    </td>
    </tr>
    `);

    return;
    }

    data.forEach(function (trip) {

    let statusBadge = trip.status === "Active"? '<span class="badge bg-danger">Active</span>': '<span class="badge bg-success">Reset</span>';
    tbody.append(`
    <tr>
    <td>${trip.tagName}</td>
    <td>${trip.tripDescription}</td>
    <td>${formatDate(trip.tripTime)}</td>
    <td>${trip.resetTime ? formatDate(trip.resetTime) : '-'}</td>
    <td>${statusBadge}</td>
    </tr>
    `);
    });
    },
    error: function (err) {
    console.log(err.responseText);
    }
    });
    }
    
    //graph js
    function openTrendModal(){

    let selectedDate = $('#selectedDate').val();
    $('#selecttrend').val(selectedGraph);
    $('#trendFrom').val(selectedDate + "T00:00");
    $('#trendTo').val(selectedDate + "T23:59");

