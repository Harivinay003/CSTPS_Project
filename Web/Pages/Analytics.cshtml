                                },

                                {
                                    dtickrange: [86400000, null],
                                    value: "%d-%b"
                                }

                            ],

                            nticks: 24,

                            showgrid: true,

                            gridcolor: '#ECEFF5'

                        },

                        yaxis: {

                            title: data.graphUnit,

                            showgrid: true,

                            gridcolor: '#ECEFF5'

                        },

                        margin: {

                            l: 70,

                            r: 20,

                            t: 20,

                            b: 60

                        },

                        hovermode: 'x unified',

                        plot_bgcolor: '#FFFFFF',

                        paper_bgcolor: '#FFFFFF'

                    },

                    {

                        responsive: true,

                        displaylogo: false

                    }

                );

            }
    });

    }

$(document).ready(function () {
    window.history.replaceState({}, document.title, window.location.pathname);
    let selectedDate = '@Model.SelectedDate?.ToString("yyyy-MM-dd")';

    if (selectedDate) {
    $('#selectedDate').val(selectedDate);
    }
    else {
    $('#selectedDate').val(new Date().toISOString().split('T')[0]);
    }

    selectedFieldDeviceId = @Model.FieldDeviceId

    let selectedDevice = $('.fielddevice[data-id="' + selectedFieldDeviceId + '"]');

    if (selectedDevice.length) {

    selectedDevice.addClass('active');

    }
    else {

    let firstDevice = $('.fielddevice').first();

    if (firstDevice.length) {

    selectedFieldDeviceId = firstDevice.data('id');
    firstDevice.addClass('active');
    }
    }

    loadDashboard(selectedFieldDeviceId);

    $('#sidebar').on('click', '.fielddevice', function (e) {

    e.preventDefault();

    $('.fielddevice').removeClass('active');

    $(this).addClass('active');

    selectedFieldDeviceId = $(this).data('id');

    loadDashboard(selectedFieldDeviceId);

    });

    $('#selectedDate').on('change', function () {

    if (selectedFieldDeviceId > 0) {

    loadDashboard(selectedFieldDeviceId);

    }

    });

    $(document).on('click', '.graph-mode', function () {

    $('.graph-mode').removeClass('active');

    $(this).addClass('active');

    selectedGraph = $(this).data('mode');

    loadDashboard(selectedFieldDeviceId);
    });

    $('.run-card').click(function () {

    $('#runDate').val($('#selectedDate').val());
    $('#runDeviceName').text($('#selectedDeviceName').text());
    $('#runHoursModal').modal('show');
    $('#runHoursModal').one('shown.bs.modal', function () {
    loadRunHours();
    });
    });

        let currentDay = new Date().toISOString().split('T')[0];

        setInterval(function() {

            let today = new Date().toISOString().split('T')[0];

            if (today !== currentDay) {

                currentDay = today;

                $('#selectedDate').val(today);

                loadDashboard(selectedFieldDeviceId);
            }
            else {

                loadDashboard(selectedFieldDeviceId);
            }

        }, 60000);

    $('#energyDuration').change(function () {

    loadEnergyChart($(this).val());

