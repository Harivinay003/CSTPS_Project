                            '</extra>'

                    });

                });

                Plotly.react(

                    'trendModalChart',

                    traces,

                    {

                        title: '',

                        showlegend: true,

                        legend: {
                            orientation: 'h',
                            y: 1.1
                        },

                        xaxis: {

                            title: 'Time',

                            type: 'date',

                            tickformatstops: [

                                {
                                    dtickrange: [null, 3600000],
                                    value: "%H:%M"
                                },

                                {
                                    dtickrange: [3600000, 86400000],
