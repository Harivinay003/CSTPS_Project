@page
@model VirtualEMS.Web.Pages.PermitsModel
@{
    ViewData["Title"] = "Permits";
    ViewData["Page"] = "4";
}
<style >
    .controlpanel {
        position: absolute;
        right: -350px;
        top: auto;
        height: 88%;
        width: 330px;
        border-top-left-radius: 5px;
        box-shadow: 5px 3px 15px #9e9e9e;
        transition: all 0.5s ease;
        z-index: 101;
    }
        .controlpanel.show {
            right: 0px;
        }
        .controlpanel .header {
            background-color: #dedede;
            border-top: solid 5px #008CE3;
            border-bottom: solid rgba(0,0,0,0.3) 1px;
            border-top-right-radius: 5px;
            border-top-left-radius: 5px;
            font-size: 20px;
            margin: 0px 0px 5px 0px;
            overflow: hidden;
            transition: all 0.5s ease;
            padding-left: 10px;
        }
    /* caret rotate for expanded/collapsed state */
    .nav-link .fa-caret-right {
        transition: transform .2s ease;
    }
    .nav-link:not(.collapsed) .fa-caret-right {
        transform: rotate(90deg);
    }
    #content {
        border-radius: 10px;
        border: solid rgba(0,0,0,0.15) 1px;
        border-top: solid black 4px;
        padding: 12px 0px;
        margin-bottom: 15px;
        margin-right: 5px;
        min-height: 85vh;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .analytics-layout {
        width: 100%;
        flex: 1;
        background: #f5f6fa;
      
        min-height: 85vh;
        margin: 0;
    }
    .page-title {
        font-size: 28px;
        font-weight: 600;
        color: #1E293B;
    }
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(6,1fr);
        gap: 18px;
        margin-top: 20px;
        margin-bottom: 25px;
    }
    .summary-card {
        background: #fff;
        border: 1px solid #E4E7EC;
        border-radius: 12px;
        padding: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        transition: .25s;
        min-height: 115px;
    }
        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }
    .summary-title {
        color: #667085;
        font-size: 14px;
        font-weight: 600;
    }
    .summary-value {
        margin-top: 18px;
        font-size: 34px;
        font-weight: 700;
        color: black;
    }
    .summary-sub {
        font-size: 12px;
        color: #98A2B3;
    }
    .panel {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #E4E7EC;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
        margin-bottom: 24px;
    }
    .panel-header {
        padding: 18px 24px;
        border-bottom: 1px solid #ECECEC;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .panel-title {
        font-size: 18px;
        font-weight: 600;
        color: #344054;
    }
    .legend {
        display: flex;
        gap: 18px;
        align-items: center;
        font-size: 13px;
    }
    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }
    .green {
        background: #16A34A;
    }
    .red {
        background: red;
    }
    @@media(max-width:1500px) {
        .summary-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }
    @@media(max-width:900px) {
        .summary-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }
    @@media(max-width:600px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
    .permit-grid {
        padding: 20px;
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(75px,1fr));
        gap: 12px;
    }
    .conveyor-card {
        height: 58px;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: .25s;
        color: #fff;
        user-select: none;
    }
        .conveyor-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,.12);
        }
    .conveyor-available {
        background: #16A34A;
    }
    .conveyor-electrical {
        background: #DC2626;
    }
    .conveyor-mechanical1 {
        background: #EA580C;
    }
    .conveyor-mechanical2 {
        background: #F59E0B;
    }
    .conveyor-operation {
        background: #2563EB;
    }
    .conveyor-permit {
        background: #7C3AED;
    }
    .conveyor-selected {
        outline: 3px solid #2563EB;
        outline-offset: 2px;
    }
    .history-panel {
        background: #fff;
        border: 1px solid #E4E7EC;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
    }
    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 25px;
        border-bottom: 1px solid #ECECEC;
    }
    .history-title {
        font-size: 22px;
        font-weight: 600;
        color: #344054;
    }
    .history-sub {
        color: #667085;
        font-size: 13px;
        margin-top: 5px;
    }
    .status-badge {
        padding: 8px 18px;
        border-radius: 20px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
    }
    .status-open {
        background: red;
    }
    .status-close {
        background: #16A34A;
    }
    .history-table {
        width: 100%;
        border-collapse: collapse;
    }
        .history-table th {
            background: #F8FAFC;
            padding: 14px;
            border-bottom: 1px solid #E5E7EB;
            font-size: 13px;
            color: #667085;
            text-align: left;
        }
        .history-table td {
            padding: 14px;
            border-bottom: 1px solid #ECECEC;
            font-size: 14px;
        }
        .history-table tbody tr:hover {
            background: #F9FAFB;
        }
    .modal-content {
        border: none;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,.18);
    }
    .modal-header {
        background: #ffffff;
        border-bottom: 1px solid #ECEFF5;
        padding: 22px 28px;
    }
    .modal-body {
        padding: 26px 28px;
        background: #FAFBFD;
    }
    .history-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        padding: 12px 16px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }
    .filter-group, .status-group {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .history-filter {
        border: none;
        outline: none;
        padding: 7px 14px;
        border-radius: 30px;
        background: #fff;
        border: 1px solid #d6d9de;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        transition: .2s;
        cursor: pointer;
    }
        .history-filter:hover {
            transform: translateY(-1px);
            box-shadow: 0 3px 10px rgba(0,0,0,.08);
        }
        .history-filter.active {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }
        .history-filter.electrical.active {
            background: #dc2626;
            border-color: #dc2626;
        }
        .history-filter.mechanical1.active {
            background: #ea580c;
            border-color: #ea580c;
        }
        .history-filter.mechanical2.active {
            background: #f59e0b;
            color: #222;
            border-color: #f59e0b;
        }
        .history-filter.operation.active {
            background: #2563eb;
            border-color: #2563eb;
        }
        .history-filter.active-status.active {
            background: #dc2626;
            border-color: #dc2626;
        }
        .history-filter.closed-status.active {
            background: #16a34a;
            border-color: #16a34a;
        }
  .history-header-bar{
    width:100%;
    display:flex;      
    align-items:center;
    gap:18px;
}
.modal-title{
    font-size:28px;
    font-weight:600;
    color:#1F2937;
}    
        .history-date label {
            font-size: 13px;
            font-weight: 600;
            color: #64748B;
            margin: 0;
        }
    #historyDate {
        width: 155px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid #D9DEE5;
        font-size: 15px;
    }
#historyDate:focus{
    box-shadow:none;
}   
    .history-date {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .date-field {
        display: flex;
        align-items: center;
        gap: 7px;
    }
        .date-field label {
            margin: 0;
            font-size: 12px;
            font-weight: 600;
            color: #64748B;
        }
        .date-field input {
            width: 145px;
            height: 36px;
            border: 1px solid #D9DEE5;
            border-radius: 8px;
            background: #F8FAFC;
            font-size: 13px;
            font-weight: 500;
            padding: 5px 9px;
        }
        .date-field input:focus {
            border-color: #2563EB;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.12);
            } 
    .conveyor-card {
        position: relative;
    }
    .conveyor-tooltip {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 8px);
        transform: translateX(-50%);
        min-width: 170px;
        padding: 10px 12px;
        background: #1F2937;
        color: #fff;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.6;
        text-align: left;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .15s ease, transform .15s ease;
        z-index: 1000;
        box-shadow: 0 8px 20px rgba(0,0,0,.18);
    }
    .conveyor-card:hover .conveyor-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(-2px);
    }
    .conveyor-tooltip-title {
        font-weight: 700;
        font-size: 12px;
        margin-bottom: 4px;
        color: #F8FAFC;
    }
    .conveyor-tooltip-type {
        display: flex;
        align-items: center;
        gap: 7px;
    }
    .conveyor-tooltip-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        flex-shrink: 0;
    }
</style>
