<div class="modal fade"
     id="permitModal"
     tabindex="-1" >
    <div class="modal-dialog modal-xl modal-dialog-centered"
         style="max-width:1300px;">
            <div class="modal-content">     
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title mb-0" id="permitModalTitle">
                    Permit History
                </h5>
                <div class="history-date">
                    <div class="date-field">
                        <label for="historyFromDate">From</label>
                        <input type="date"
                               id="historyFromDate"
                               class="form-control">
                    </div>
                    <div class="date-field">
                        <label for="historyToDate">To</label>
                        <input type="date"
                               id="historyToDate"
                               class="form-control">
                    </div>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>
            </div>
            <div class="history-toolbar">
                <div class="filter-group">
                    <button class="history-filter active all" data-type="All">
                        <i class="bi bi-grid"></i> All
                    </button>
                    <button class="history-filter electrical" data-type="1">
                         Electrical
                    </button>
                    <button class="history-filter mechanical1" data-type="2">
                        Mechanical-01
                    </button>
                    <button class="history-filter mechanical2" data-type="3">
                         Mechanical-02
                    </button>
                    <button class="history-filter operation" data-type="4">
                         Operation
                    </button>
                </div>
                <div class="status-group">
                    <button class="history-filter status active-status"
                            data-status="Active">
                        Active
                    </button>
                    <button class="history-filter status closed-status"
                            data-status="Closed">
                        Closed
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Permit</th>
                            <th>Work Type</th>
                            <th>Issued</th>
                            <th>Cleared</th>
                            <th>Duration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="permitHistory">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    let selectedFieldDeviceId = 0;
    let userSelectedConveyor = false;
    let currentPermitType = "All";
    let currentStatus = "All";
    function loadDashboard() {
        $.getJSON("?handler=PermitDashboard", function(data) {
            $("#availabilityPercentage").text(data.fleetAvailability + "%");
            $("#availabilityText").text(data.clearConveyors + " of " + data.totalConveyors + " available");
            $("#underPermitCount").text(data.activePermits);
            $("#todayPermitHours").text(data.permitHoursToday + " hrs");
            $("#highestPermitArea").text(data.highestPermitType);
            $("#highestPermitCount").text(data.highestPermitCount + " Active");
            $("#longestPermitHours").text(data.longestOpenHours + " hrs");
            $("#longestPermitName").text(data.longestOpenConveyor + " (" + data.longestOpenType + ")");
            $("#conveyorContainer").empty();
            data.conveyors.forEach(function(item) {
                let permits = [];
                if (item.electrical) {
                    permits.push({
                        key: "E",
                        name: "Electrical",
                        color: "#DC2626"
                    });
                }
                if (item.mechanical1) {
                    permits.push({
                        key: "M1",
                        name: "Mechanical-01",
                        color: "#EA580C"
                    });
                }
                if (item.mechanical2) {
                    permits.push({
                        key: "M2",
                        name: "Mechanical-02",
                        color: "#F59E0B"
                    });
                }
                if (item.operation) {
                    permits.push({
                        key: "O",
                        name: "Operation",
                        color: "#2563EB"
                    });
                }
                let cls = "conveyor-available";
                let background = "";
                if (permits.length === 0) {

                    if (item.mainPermit) {
                        cls = "conveyor-permit";
                    }
                }
                else if (permits.length === 1) {
                    cls = "conveyor-card";
                    background = permits[0].color;
                }
                else if (permits.length >= 2) {
                    cls = "conveyor-card";
                    const sectionWidth = 100 / permits.length;
                    let stops = [];
                    permits.forEach((permit, index) => {
                        const start = index * sectionWidth;
                        const end = (index + 1) * sectionWidth;
                        stops.push(
                            `${permit.color} ${start}%`,
                            `${permit.color} ${end}%`
                        );
                    });
                    background = `linear-gradient( to right, ${stops.join(", ")} )`;
                }
                let tooltip = "";
                if (permits.length > 0) {
                    tooltip = ` <div class="conveyor-tooltip">
                    <div class="conveyor-tooltip-title">
                        Active Permits
                    </div>
                    ${permits.map(p => `
                        <div class="conveyor-tooltip-type">
                            <span class="conveyor-tooltip-dot"
                                  style="background:${p.color}">
                            </span>
                            ${p.name}
                        </div>
                    `).join("")}
                </div>
            `;
                }
                else if (item.mainPermit) {
                    tooltip = `<div class="conveyor-tooltip">
                    <div class="conveyor-tooltip-title">
                        Active Permit
                    </div>
                    <div class="conveyor-tooltip-type">
                        <span class="conveyor-tooltip-dot"
                              style="background:#7C3AED">
                        </span>
                        Permit
                    </div>
                </div>
            `;
                }
                let card = $(`
            <div class="conveyor-card ${cls}"
                 data-id="${item.fieldDeviceId}">
                ${item.name}
                ${tooltip}
            </div>
        `);
                if (background) {
                    card.css("background", background);
                }
                card.click(function() {
                    userSelectedConveyor = true;
                    $(".conveyor-card").removeClass("conveyor-selected");
                    $(this).addClass("conveyor-selected");
                    selectedFieldDeviceId = item.fieldDeviceId;
                    $("#permitModalTitle").text(item.name + " - Permit History");
                    const today = new Date().toISOString().split("T")[0];
                    $("#historyFromDate").val(today);
                    $("#historyToDate").val(today);
                    currentPermitType = "All";
                    currentStatus = "All";
                    $(".history-filter").removeClass("active");
                    $('.filter-group .history-filter[data-type="All"]').addClass("active");
                    loadPermitHistory();
                    $("#permitModal").modal("show");
                });
                $("#conveyorContainer").append(card);
            });
           if (userSelectedConveyor) {
                let selected = $("#conveyorContainer .conveyor-card[data-id='" + selectedFieldDeviceId + "']");
                if (selected.length) {
                    selected.addClass("conveyor-selected");
                }
            }
        });
    }
    function getPermitTypeName(type) {
        switch (type) {
            case 1:
                return '<span class="badge bg-danger">Electrical</span>';
            case 2:
                return '<span class="badge bg-warning text-dark">Mechanical-01</span>';
            case 3:
                return '<span class="badge bg-warning">Mechanical-02</span>';
            case 4:
                return '<span class="badge bg-primary">Operation</span>';
            default:
                return '<span class="badge bg-secondary">Permit</span>';
        }
    }
    function loadPermitHistory() {
        $.getJSON(
            "?handler=PermitHistory",
            {
                fieldDeviceId: selectedFieldDeviceId,
                fromDate: $("#historyFromDate").val(),
                toDate: $("#historyToDate").val()
            },
            function(data) {
                let tbody = $("#permitHistory");
                tbody.empty();
                if (data.length === 0) {
                    tbody.append(`
            <tr>
                <td colspan="6"
                    class="text-center" >
                    No permit history found for <b>${$("#permitModalTitle").text().replace(" - Permit History", "")}</b>.
                </td>
            </tr>
        `);
                    return;
                }
                let activePermit = false;
                let filtered = data;
                if (currentPermitType !== "All") {
                    filtered = filtered.filter(x => x.permitType == Number(currentPermitType));
                }
                if (currentStatus !== "All") {
                    filtered = filtered.filter(x => x.status == currentStatus);
                }
                if (filtered.length === 0) {
                    tbody.append(`
            <tr>
                <td colspan="6" class="text-center text-muted">
                    No permits found for the selected filters.
                </td>
            </tr>
        `);
                    return;
                }
                filtered.forEach(function(p) {
                    if (p.status === "Active") {
                        activePermit = true;
                    }
              let statusBadge = p.status === "Active" ? '<span class="badge bg-danger">Active</span>' : '<span class="badge bg-success">Closed</span>';
                    tbody.append(`
    <tr>
         <td>${p.permitName}</td>
    <td>${getPermitTypeName(p.permitType)}</td>
    <td>${formatDate(p.issuedTime)}</td>
    <td>${p.clearedTime ? formatDate(p.clearedTime) : "-"}</td>
    <td>${p.duration}</td>   
    <td>${statusBadge}</td>
    </tr>
    `);
                });
            });
    }
    function loadPermitTrend() {
        $.getJSON("?handler=PermitTrend", function(data) {
            let days = [];
            let electrical = [];
            let mechanical1 = [];
            let mechanical2 = [];
            let operation = [];
            data.forEach(function(d) {
                days.push(d.day);
                electrical.push(d.electrical);
                mechanical1.push(d.mechanical1);
                mechanical2.push(d.mechanical2);
                operation.push(d.operation);
            });
            Plotly.newPlot(
                "permitTrendChart",
                [
                    {
                        x: days,
                        y: electrical,
                        type: "bar",
                        name: "Electrical",
                        marker: {
                            color: "#DC2626"
                        }
                    },
                    {
                        x: days,
                        y: mechanical1,
                        type: "bar",
                        name: "Mechanical-01",
                        marker: {
                            color: "#EA580C"
                        }
                    },
                    {
                        x: days,
                        y: mechanical2,
                        type: "bar",
                        name: "Mechanical-02",
                        marker: {
                            color: "#F59E0B"
                        }
                    },
                    {
                        x: days,
                        y: operation,
                        type: "bar",
                        name: "Operation",
                        marker: {
                            color: "#2563EB"
                        }
                    }
                ],
                {
                    barmode: "stack",
                    margin: {
                        l: 55,
                        r: 20,
                        t: 20,
                        b: 40
                    },
                    xaxis: {
                        title: "Day"
                    },
                    yaxis: {
                        title: "Permit Hours"
                    },
                    legend: {
                        orientation: "h",
                        y: 1.15
                    },
                    paper_bgcolor: "#fff",
                    plot_bgcolor: "#fff"
                },
                {
                    responsive: true,
                    displaylogo: false
                });
        });
    }
    function loadTopPermitChart() {
        $.getJSON("?handler=TopConveyors", function(data) {
            let y = [];
            let x = [];
            data.forEach(function(d) {
                y.push(d.name);
                x.push(d.totalHours);
            });
            Plotly.newPlot(
                "topPermitChart",
                [{
                    type: "bar",
                    orientation: "h",
                    y: y,
                    x: x,
                    marker: {
                        color: "#F59E0B"
                    }
                }],
                {
                    margin: {
                        l: 80,
                        r: 20,
                        t: 20,
                        b: 40
                    },
                    xaxis: {
                        title: "Hours"
                    },
                    yaxis: {
                        autorange: "reversed"
                    },
                    showlegend: false,
                    paper_bgcolor: "#fff",
                    plot_bgcolor: "#fff"
                },
                {
                    responsive: true,
                    displaylogo: false
                });
        });
    }
    function refreshDashboard() {
        let previous = selectedFieldDeviceId;
        loadDashboard();
        if (previous > 0) {
            selectedFieldDeviceId = previous;
            loadPermitHistory();
        }
    }
    function formatDate(dateString) {
        let d = new Date(dateString);
        return d.toLocaleString('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        });
    }
    $(document).ready(function() {
        loadDashboard();
        loadPermitTrend();
        loadTopPermitChart();

        $(document).on("click", ".history-filter", function() {
            $(".history-filter").removeClass("active");
            $(this).addClass("active");
            currentPermitType = $(this).data("type") || "All";
            currentStatus = $(this).data("status") || "All";
            loadPermitHistory();
        });
        $('#permitModal').on('hidden.bs.modal', function() {
            currentPermitType = "All";
            currentStatus = "All";
            $(".history-filter").removeClass("active");
            $('.history-filter[data-type="All"]').addClass("active");
        });
        $("#historyDate").on("change", function() {
            loadPermitHistory();
        });
        $("#historyFromDate, #historyToDate").on("change", function() {
            const from = $("#historyFromDate").val();
            const to = $("#historyToDate").val();
            if (from && to && from > to) {
                alert("From date cannot be later than To date.");
                return;
            }
            loadPermitHistory();
        });
        setInterval(function() {
            refreshDashboard();
            loadPermitTrend();
            loadTopPermitChart();
        }, 60000);
    });
</script>