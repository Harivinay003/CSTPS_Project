<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["Title"] != null)
    {
        <title>@ViewData["Title"] - VirtualEMS</title>
    }
    else
    {
        <title>VirtualEMS</title>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VirtualEMS.Web.styles.css" asp-append-version="true" />
    <style>
        .alarm-banner {
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 3px 0;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
            /* border-bottom: 1px solid black;
            box-shadow: 0 1px 2px rgba(0,0,0,0.2); */
        }

        .alarm-banner.no-alarms {
            /* background: linear-gradient(90deg, #4CAF50 0%, #45a049 100%);
            border-bottom: 2px solid #3d8b40; */
            display:none;
        }

        .alarm-content {
            display: inline-block;
            padding-left: 100%;
            animation: scroll-left 30s linear infinite;
            font-weight: 600;
            font-size: 12px;
        }

        .alarm-item {
            display: inline-block;
            /* margin-right: 30px; */
            padding: 0 30px;
            border-right: 2px solid rgba(255,255,255,0.6);
        }

        .alarm-item:last-child {
            border-right: none;
        }

        .alarm-icon {
                color: #008CE3;
            animation: blink 2s infinite;
            margin-right: 8px;
        }

        @@keyframes scroll-left {
            0% {
                transform: translate(0, 0);
            }
            100% {
                transform: translate(-100%, 0);
            }
        }

        @@keyframes blink {
            0%, 50%, 100% {
                opacity: 1;
            }
            25%, 75% {
                opacity: 0.3;
            }
        }

        .alarm-banner:hover .alarm-content {
            animation-play-state: paused;
        }
    </style>
</head>
<body>
    <header>
        <div class="bg-light d-flex justify-content-between">
            <div>
                <img class="p-1" src="~/images/CSTPS_logo.jpeg" width="150" height="70">
                @* <img class="p-1" src="~/images/myhome.png" width="100" height="70">` *@
            </div>
            <h1 class="m-3" style="font-weight:700; font-family: Verdana, sans-serif; color: black;"> CHANDRAPUR SUPER THERMAL POWER STATION</h1>
            <img class="p-1" src="~/images/va.png" width="200" height="70">
        </div>

        <!-- Alarm Banner -->
        <div id="alarmBanner" class="alarm-banner no-alarms mb-1">
            <div class="alarm-content" id="alarmContent">
                <span class="alarm-item">
                    <i class="fas fa-check-circle"></i>
                    <span>No Active Alarms - System Operating Normally</span>
                </span>
            </div>
        </div>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white box-shadow mb-2" style="padding-top: 0;padding-left:2px; padding-bottom: 0; border-bottom: 2px black solid">
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="mainNavbar" class="navbar-collapse collapse">
                <ul class="navbar-nav nav-pills">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Page"]?.ToString() == "3" ? "active" : "")" asp-page="/Analytics">Analytics</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Page"]?.ToString() == "4" ? "active" : "")" asp-page="/Permits">Permits</a>
                    </li>
                </ul>
                <div class="ms-auto me-3" style="font-size:20px;color:black;font-weight:600;">                      
                        <span id="date">@DateTime.Now.Date.ToString("dd-MMM-yyyy")</span>                    
                        <span id="time">@DateTime.Now.ToString("HH:mm:ss")</span>
                </div>
            </div>
        </nav>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/d3/d3.min.js"></script>
    <script src="~/lib/exceljs/exceljs.min.js"></script>
    <script src="~/lib/filesaver.js/filesaver.min.js"></script> 
    <script src="~/lib/plotly.js/plotly.min.js"></script>
    <script src="~/lib/html2canvas/html2canvas.min.js"></script>
    <script>
        function updateDateTime() {
            const now = new Date();

            // Update time (HH:mm:ss)
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('time').textContent = `${hours}:${minutes}:${seconds}`;

            // Update date (dd/MMM/yyyy)
            const day = String(now.getDate()).padStart(2, '0');
            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            const month = monthNames[now.getMonth()];
            const year = now.getFullYear();
            document.getElementById('date').textContent = `${day}/${month}/${year}`;
        }

        // Update immediately on page load
        updateDateTime();

        // Update every second
        setInterval(updateDateTime, 1000);

    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>